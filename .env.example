# Copy this file to .env and fill in the values you use.
# Google Drive archive folder IDs. Share the folders with the selected account.
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_IMAGE_FOLDER_ID=
GOOGLE_DRIVE_VIDEO_FOLDER_ID=
GOOGLE_DRIVE_DOWNLOAD_FOLDER_ID=

# Recommended: OAuth client JSON downloaded from Google Cloud.
# Authorize rasuwaflood@gmail.com with: npm run drive:auth
GOOGLE_OAUTH_CLIENT_FILE=
# Optional custom path; otherwise .oauth-token.json is used automatically.
GOOGLE_OAUTH_TOKEN_FILE=

# Alternative server credential: service-account JSON key.
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=

# Alternative inline service-account credentials. Keep the private key secret.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Legacy OAuth variables, also supported.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Optional Google Maps JavaScript API key for the Satellite map button.
# Restrict this browser key to your site origins in Google Cloud Console.
GOOGLE_MAPS_API_KEY=

# Optional; defaults to 3000.
PORT=3000
