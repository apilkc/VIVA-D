{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "viva-d",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-09-01",
  "build": { "command": "node cloudflare/build.mjs" },
  "assets": { "directory": "cloudflare/public", "binding": "ASSETS", "run_worker_first": ["/api/*", "/browse"] },
  "keep_vars": true
}
