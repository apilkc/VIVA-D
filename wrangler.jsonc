{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "viva-d",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-10-01",
  "account_id": "e750cc19c12ab28f4a882dfe99d4e3d8",
  "workers_dev": true,
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "vars": { "GOOGLE_CLOUD_STORAGE_BUCKET": "rasuwa-flood-media-viva" },
  "triggers": { "crons": ["0 4 * * *"] },
  "observability": { "enabled": true }
}
